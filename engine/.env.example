# YECH Commercial Engine: environment template.
# Copy to .env.local for local development. Never commit real values.
# Leave a value empty to keep that feature in its visible "not configured" state.

# Supabase project (Project Settings > API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by the staff invitation action (team/actions.ts). Never prefix with NEXT_PUBLIC_.
# Leave empty to disable invitations.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this engine, used in invitation and password-reset links.
# Example: https://engine.yech.sa   (proposed; not yet registered)
ENGINE_PUBLIC_URL=

# Public website origin (for the "back to website" link). Optional.
NEXT_PUBLIC_WEBSITE_URL=
