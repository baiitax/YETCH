# Copy to .env (never commit .env). The server reads these from the process environment.
# Nothing in this file is a secret by itself; keep real webhook URLs out of source control.

# HTTP
PORT=3000
HOST=0.0.0.0
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
# Set to 1 only when the site is served over HTTPS (adds Strict-Transport-Security).
HSTS=0
# frame-ancestors value. Default keeps the platform preview embeddable.
# FRAME_ANCESTORS='self' https:

# Operations
# 1 = show the maintenance page for all HTML routes and return 503 for enquiries.
MAINTENANCE=0
LOG_REQUESTS=0

# Enquiry storage (JSON lines, owner-only permissions). Keep this outside the web root.
DATA_DIR=./data

# Enquiry notification (PENDING CONFIGURATION).
# Leave empty until a real, contracted destination exists (CRM, helpdesk, or a shared inbox
# under a processor agreement). When empty, submissions are stored and marked "pending".
NOTIFY_WEBHOOK_URL=

# Same-origin is enforced by default. Only list additional origins you control.
ALLOWED_ORIGINS=

# Abuse protection: maximum enquiries per client per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
